# PayGuard-Neural Environment Variables
# Copy this file to .env and fill in your values

# Claude API key for AI-powered risk explanations (Stage 3)
# Get yours at: https://console.anthropic.com/
# The system works WITHOUT this key — scores are still accurate,
# only the AI explanation falls back to a static message.
ANTHROPIC_API_KEY=

# Server port (default: 5000)
PORT=5000
